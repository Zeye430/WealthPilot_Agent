# Reverse proxy: obtains and renews HTTPS certificates automatically (Let's Encrypt); health checks go straight to the backend, everything else to the frontend (which proxies /api to the backend).
# With DOMAIN=localhost, Caddy uses a locally issued certificate, for verifying the production config on this machine.
{$DOMAIN} {
	encode zstd gzip

	# Prometheus metrics are for internal monitoring only, never public (also protected by a token)
	@internal path /metrics /metrics/*
	respond @internal 404

	# Health checks go straight to the backend, bypassing the frontend: the deploy script uses them to tell whether the backend is ready
	@health path /health /health/*
	reverse_proxy @health backend:8000

	reverse_proxy frontend:3000 {
		# Overwrite any client-supplied X-Forwarded-For so a forged IP can't bypass the sign-in rate limit
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output stdout
		format json
	}
}
