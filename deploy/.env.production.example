# 复制为 deploy/.env.production 并填写（该文件已在 .gitignore 中，不会提交）。
# 部署脚本会把它上传到服务器；所有标注「必填」的项都要改，不要用示例值。

# ---------- 访问地址 ----------
# 留空：自动使用 <服务器IP>.sslip.io（免费，无需购买域名，同样有 HTTPS）
# 自有域名：先把 A 记录指向部署脚本输出的静态 IP，再填写，如 wealthpilot.example.com
DOMAIN=

# ---------- 必填：模型 ----------
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_API_KEY=
LLM_MODEL=kimi-k2.6
LLM_TEMPERATURE=1
LLM_AGENT_THINKING=false

# ---------- 必填：密码与密钥（用 `openssl rand -hex 32` 生成） ----------
POSTGRES_PASSWORD=
# 手机银行进入凭证的签名密钥
APP_TICKET_SECRET=
# 演示账号统一密码（公开部署必须修改）
DEMO_PASSWORD=
# 访问码：登录时需要输入，防止陌生人刷模型额度；发给面试官
DEMO_ACCESS_CODE=
# 登录页提示（留空则不显示密码提示）
DEMO_LOGIN_HINT=
DEMO_LOGIN_HINT_EN=
# Prometheus 指标令牌（公网已屏蔽 /metrics，行内监控抓取时使用）
METRICS_TOKEN=

# ---------- 可选 ----------
# 是否下载语音识别模型（约 240MB；2 GB 内存的服务器建议保留默认，语音按需加载）
VOICE_ENABLED=true
