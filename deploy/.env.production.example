# Copy to deploy/.env.production and fill in (that file is in .gitignore and won't be committed).
# The deploy script uploads it to the server; change every item marked required, never keep example values.

# ---------- Site address ----------
# Empty: use <server IP>.sslip.io automatically (free, no domain needed, still HTTPS)
# Own domain: point its A record at the static IP the deploy script prints, then fill it in, e.g. wealthpilot.example.com
DOMAIN=

# ---------- Required: model ----------
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_API_KEY=
LLM_MODEL=kimi-k2.6
LLM_TEMPERATURE=1
LLM_AGENT_THINKING=false

# ---------- Required: passwords and secrets (generate with `openssl rand -hex 32`) ----------
POSTGRES_PASSWORD=
# Signing key for mobile banking entry tickets
APP_TICKET_SECRET=
# Shared password for demo accounts (must change for public deployments)
DEMO_PASSWORD=
# Access code: required at sign-in so strangers can't burn model credits; share it with interviewers
DEMO_ACCESS_CODE=
# Sign-in page hint (leave empty to show no password hint)
DEMO_LOGIN_HINT=
DEMO_LOGIN_HINT_EN=
# Prometheus metrics token (/metrics is blocked publicly; used by internal monitoring)
METRICS_TOKEN=

# ---------- Optional ----------
# Whether to download the speech recognition model (about 240 MB; on a 2 GB server keep the default, speech loads on demand)
VOICE_ENABLED=true
