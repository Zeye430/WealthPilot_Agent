# The backend image uses the repo root as build context: include only backend/ and data/, exclude everything else
*
!backend/
!data/

# Real institutions' public documents are for local reference only and must never enter the image
data/reference/
# Local environment and caches
backend/.venv/
backend/.models/
backend/.env
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
