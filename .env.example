# Copy to .env and fill in (.env is in .gitignore and won't be committed)

# ---------- Model ----------
# LLM_PROVIDER:
#   kimi | deepseek | qwen | glm      Chinese models: only LLM_API_KEY is needed; base URL and model
#                                     have defaults, and thinking is turned off the way each vendor
#                                     requires (see backend/app/llm/client.py)
#   openai_compatible                 any other OpenAI-compatible API: set LLM_BASE_URL and LLM_MODEL
#   anthropic | gemini | azure_openai Claude, Gemini, Azure OpenAI (see below)
# Kimi (default), DeepSeek and Qwen have been evaluated end to end (see Model comparison in the
# README); DeepSeek is the best low-cost option. After switching, run
# `cd backend && uv run python scripts/check_llm.py`, re-run the scenario evaluation, and set
# LLM_PRICE_* to the new model's prices (cost tracking uses Kimi's prices otherwise).
LLM_PROVIDER=kimi
LLM_API_KEY=
# Optional overrides; empty uses the provider's defaults
LLM_BASE_URL=
LLM_MODEL=
# Optional cheaper model for topic routing (same provider); empty uses the main model
LLM_ROUTER_MODEL=
# Temperature for models without a fixed rule; empty uses the model's default
LLM_TEMPERATURE=
# Thinking for the main agent (about twice as slow when on); always off for routing.
# Not available for DeepSeek with tool calls.
LLM_AGENT_THINKING=false
#
# Presets (defaults as of 2026-10; vendors rename models often, so override LLM_MODEL if needed):
#   kimi      https://api.moonshot.ai/v1 (China: https://api.moonshot.cn/v1)   kimi-k2.6
#   deepseek  https://api.deepseek.com                                         deepseek-flash
#   qwen      https://dashscope.aliyuncs.com/compatible-mode/v1                qwen-plus   (router: qwen-flash)
#             Alibaba now recommends your workspace URL, e.g.
#             https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#   glm       https://api.z.ai/api/paas/v4 (China: https://open.bigmodel.cn/api/paas/v4)   glm-4.7
#             (router: glm-4.7-flash)
# Keys are tied to a site: use the URL of the site that issued yours.
#
# Other providers:
#   OpenAI      LLM_PROVIDER=openai_compatible  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4.1
#   Ollama      LLM_PROVIDER=openai_compatible  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
#   Claude      LLM_PROVIDER=anthropic   LLM_MODEL=claude-sonnet-5-5
#   Gemini      LLM_PROVIDER=gemini      LLM_MODEL=gemini-2.5-flash
#   Azure       LLM_PROVIDER=azure_openai  LLM_BASE_URL=https://<resource>.openai.azure.com
#               LLM_MODEL=<deployment name>  LLM_API_VERSION=2024-10-21
# The model must support tool calling.

# Local development (after docker compose up -d db)
DATABASE_URL=postgresql+psycopg://wealthpilot:wealthpilot@localhost:5433/wealthpilot

# ---------- Security (keep defaults for local development; must change for public deployments) ----------
# Allowed frontend origins (JSON array): shared by CORS and the cross-site write check; set to the real domain when deploying
# CORS_ORIGINS=["https://wealthpilot.example.com"]
# Set to true behind HTTPS so the session cookie is only sent over HTTPS
# COOKIE_SECURE=true
# Public demo access code: when set, sign-in requires it so strangers can't burn model credits
# DEMO_ACCESS_CODE=
# Shared password for demo accounts (change it for public deployments) and the sign-in page hint
# DEMO_PASSWORD=
# DEMO_LOGIN_HINT=

# ---------- Observability and reliability (P8-3 / P8-4; keep defaults for local development) ----------
# Set to json when deploying: one JSON log per line (with request IDs), easy to search and alert on
# LOG_FORMAT=json
# Access token for the Prometheus /metrics endpoint; the endpoint is off when unset
# METRICS_TOKEN=
# Injected by CI with the current commit when deploying; the ops dashboard shows the running version
# GIT_SHA=
# Turn time budget (seconds), model circuit breaker (consecutive failures / cooldown seconds)
# CHAT_TURN_BUDGET_SECONDS=60
# LLM_BREAKER_FAILURES=5
# LLM_BREAKER_COOLDOWN_SECONDS=30
# Prices for cost estimates (USD per million tokens); the provider's published prices are authoritative (defaults are kimi-k2.6 cache-miss prices)
# LLM_PRICE_INPUT_PER_MTOK=0.95
# LLM_PRICE_OUTPUT_PER_MTOK=4.00
# Database pool (per process); with several processes keep processes × (pool + overflow) below PostgreSQL's connection limit
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ---------- Entry from mobile banking (P8-5) ----------
# Shared secret the bank app uses to sign entry tickets and WealthPilot uses to verify them (must be a long random value when deploying;
# in production, prefer bank private-key signing with WealthPilot holding only the public key)
# APP_TICKET_SECRET=
# APP_TICKET_TTL_SECONDS=60
# Simulated mobile banking (demo); set to false once connected to a real banking app
# BANK_SIM_ENABLED=true
