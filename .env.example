# Copy to .env and fill in (.env is in .gitignore and won't be committed)

# Kimi / Moonshot (OpenAI-compatible API)
# The key must match the site: international https://api.moonshot.ai/v1 ; China https://api.moonshot.cn/v1
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_API_KEY=
# Valid model names are those listed by `uv run python scripts/check_llm.py`
LLM_MODEL=kimi-k2.6
# kimi-k2.6 / kimi-k3 only accept temperature=1
LLM_TEMPERATURE=1
# Thinking mode for the main agent (about twice as slow when on); always off for the topic router
LLM_AGENT_THINKING=false

# Local development (after docker compose up -d db)
DATABASE_URL=postgresql+psycopg://wealthpilot:wealthpilot@localhost:5433/wealthpilot

# ---------- Security (keep defaults for local development; must change for public deployments) ----------
# Allowed frontend origins (JSON array): shared by CORS and the cross-site write check; set to the real domain when deploying
# CORS_ORIGINS=["https://wealthpilot.example.com"]
# Set to true behind HTTPS so the session cookie is only sent over HTTPS
# COOKIE_SECURE=true
# Public demo access code: when set, sign-in requires it so strangers can't burn model credits
# DEMO_ACCESS_CODE=
# Shared password for demo accounts (change it for public deployments) and the sign-in page hint
# DEMO_PASSWORD=
# DEMO_LOGIN_HINT=

# ---------- Observability and reliability (P8-3 / P8-4; keep defaults for local development) ----------
# Set to json when deploying: one JSON log per line (with request IDs), easy to search and alert on
# LOG_FORMAT=json
# Access token for the Prometheus /metrics endpoint; the endpoint is off when unset
# METRICS_TOKEN=
# Injected by CI with the current commit when deploying; the ops dashboard shows the running version
# GIT_SHA=
# Turn time budget (seconds), model circuit breaker (consecutive failures / cooldown seconds)
# CHAT_TURN_BUDGET_SECONDS=60
# LLM_BREAKER_FAILURES=5
# LLM_BREAKER_COOLDOWN_SECONDS=30
# Prices for cost estimates (USD per million tokens); the provider's published prices are authoritative (defaults are kimi-k2.6 cache-miss prices)
# LLM_PRICE_INPUT_PER_MTOK=0.95
# LLM_PRICE_OUTPUT_PER_MTOK=4.00
# Database pool (per process); with several processes keep processes × (pool + overflow) below PostgreSQL's connection limit
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ---------- Entry from mobile banking (P8-5) ----------
# Shared secret the bank app uses to sign entry tickets and WealthPilot uses to verify them (must be a long random value when deploying;
# in production, prefer bank private-key signing with WealthPilot holding only the public key)
# APP_TICKET_SECRET=
# APP_TICKET_TTL_SECONDS=60
# Simulated mobile banking (demo); set to false once connected to a real banking app
# BANK_SIM_ENABLED=true
