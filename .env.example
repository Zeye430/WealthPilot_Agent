# 复制为 .env 并填写（.env 已在 .gitignore 中，不会提交）

# Kimi / Moonshot（OpenAI 兼容接口）
# Key 与站点需对应：国际站 https://api.moonshot.ai/v1 ；中国站 https://api.moonshot.cn/v1
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_API_KEY=
# 可用模型名以 `uv run python scripts/check_llm.py` 列出的为准
LLM_MODEL=kimi-k2.6
# kimi-k2.6 / kimi-k3 只接受 temperature=1
LLM_TEMPERATURE=1
# 主 Agent 是否开启思考模式（开启约慢一倍）；话题路由始终关闭
LLM_AGENT_THINKING=false

# 本地开发（docker compose up -d db 之后）
DATABASE_URL=postgresql+psycopg://wealthpilot:wealthpilot@localhost:5433/wealthpilot

# ---------- 安全（本地开发保持默认即可；公开部署时必须修改） ----------
# 允许的前端来源（JSON 数组）：CORS 与跨站写请求检查共用，部署时改为正式域名
# CORS_ORIGINS=["https://wealthpilot.example.com"]
# 部署到 HTTPS 时设为 true，会话 Cookie 只经 HTTPS 发送
# COOKIE_SECURE=true
# 公开演示访问码：设置后登录需要输入，防止陌生人刷模型额度
# DEMO_ACCESS_CODE=
# 演示账号的统一密码（公开部署时请修改）与登录页提示
# DEMO_PASSWORD=
# DEMO_LOGIN_HINT=

# ---------- 可观测性与可靠性（P8-3 / P8-4；本地开发保持默认即可） ----------
# 部署时设为 json：每行一个 JSON 日志（含请求编号），便于云平台检索与告警
# LOG_FORMAT=json
# Prometheus 指标接口 /metrics 的访问令牌；不设置时接口关闭
# METRICS_TOKEN=
# 部署时由 CI 注入当前提交，运维看板显示正在运行的版本
# GIT_SHA=
# 单轮对话时长上限（秒）、模型熔断（连续失败次数 / 冷却秒数）
# CHAT_TURN_BUDGET_SECONDS=60
# LLM_BREAKER_FAILURES=5
# LLM_BREAKER_COOLDOWN_SECONDS=30
# 费用估算单价（美元 / 百万 token），以模型服务商官网为准（默认为 kimi-k2.6 未命中缓存的价格）
# LLM_PRICE_INPUT_PER_MTOK=0.95
# LLM_PRICE_OUTPUT_PER_MTOK=4.00
# 数据库连接池（每进程）；多进程部署时保证「进程数 ×（池 + 溢出）」小于 PostgreSQL 连接上限
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ---------- 手机银行进入（P8-5） ----------
# 银行 App 签发、WealthPilot 核验进入凭证的共享密钥（部署时必须修改为足够长的随机值；
# 生产中更推荐银行私钥签名、WealthPilot 只持有公钥）
# APP_TICKET_SECRET=
# APP_TICKET_TTL_SECONDS=60
# 模拟手机银行（演示用）；对接真实手机银行后设为 false
# BANK_SIM_ENABLED=true
